#!/usr/bin/env bash
# Patchstack: Git automation for maintaining patch stacks
# Maintains long-living forks as deterministic patch stacks on top of upstream repositories

set -euo pipefail

# Default configuration (zero-config)
PATCH_REMOTE="${PATCH_REMOTE:-origin}"
UPSTREAM_REMOTE="${UPSTREAM_REMOTE:-upstream}"
MAIN_BRANCH="${MAIN_BRANCH:-main}"

# Temporary resource locations (initialized in cmd_sync)
RUN_ID=""
RUN_REF_PREFIX=""
RUN_TEMP_DIR=""

# Lock file for preventing concurrent runs
LOCK_FILE="${TMPDIR:-/tmp}/patchstack.lock"
LOCK_ACQUIRED=false

# Verbosity helper - discards output for now, can be changed later
# Usage: verbose_echo "debug message"
verbose_echo() {
    # Currently discards all verbose output
    # TODO: Add verbosity levels (e.g., PATCHSTACK_VERBOSE=1)
    :
}

# Acquire exclusive lock to prevent concurrent runs
acquire_lock() {
    verbose_echo "Acquiring lock at $LOCK_FILE"
    
    # Open lock file on FD 200
    exec 200>"$LOCK_FILE"
    
    # Try to acquire exclusive lock (non-blocking)
    if ! flock -n 200; then
        echo "ERROR: Another patchstack process is already running" >&2
        echo "If this is incorrect, remove the lock file: $LOCK_FILE" >&2
        exit 1
    fi
    
    verbose_echo "Lock acquired"
    LOCK_ACQUIRED=true
}

# Release lock
release_lock() {
    verbose_echo "Releasing lock"
    if [[ "${LOCK_ACQUIRED}" == "true" ]]; then
        flock -u 200 2>/dev/null || true
        exec 200>&- 2>/dev/null || true
        LOCK_ACQUIRED=false
    fi
}

# Cleanup temporary resources
cleanup_temp_resources() {
    verbose_echo "Cleaning up temporary resources for run $RUN_ID"
    
    # Clean up temporary directory
    if [[ -n "${RUN_TEMP_DIR:-}" ]] && [[ -d "$RUN_TEMP_DIR" ]]; then
        rm -rf "$RUN_TEMP_DIR" 2>/dev/null || true
    fi
    
    # Clean up temporary branches (should already be deleted by normal flow)
    local temp_branches
    readarray -t temp_branches < <(git branch --list "patchstack-${RUN_ID}-*" 2>/dev/null || printf '')
    for branch in "${temp_branches[@]}"; do
        if [[ -n "$branch" ]]; then
            git branch -D "$branch" 2>/dev/null || true
        fi
    done
    
    # NOTE: We intentionally do NOT clean up temporary refs immediately
    # ($RUN_REF_PREFIX/*) to allow for debugging and test verification.
    # Stale refs from old runs will be cleaned up by cleanup_stale_refs()
    # which is called at the start of the next run.
}

# Cleanup stale temporary refs from old runs
# Called at the start of each run to remove data from interrupted previous runs
cleanup_stale_refs() {
    verbose_echo "Cleaning up stale refs from previous runs"
    
    # Get all run directories
    local all_runs
    all_runs=$(git for-each-ref --format='%(refname)' 'refs/patchstack/runs/' 2>/dev/null | \
               sed 's|refs/patchstack/runs/\([^/]*\)/.*|\1|' | sort -u || echo "")
    
    if [[ -z "$all_runs" ]]; then
        return 0
    fi
    
    # Process each old run and count deleted refs
    local cleaned=0
    while IFS= read -r run_id; do
        # Skip current run
        [[ "$run_id" == "$RUN_ID" ]] && continue
        
        # Get count of refs for this run before deletion
        local run_refs
        run_refs=$(git for-each-ref --format='%(refname)' "refs/patchstack/runs/$run_id/" 2>/dev/null | wc -l)
        
        # Remove all refs for this old run
        git for-each-ref --format='%(refname)' "refs/patchstack/runs/$run_id/" 2>/dev/null | \
          while read -r ref; do
            git update-ref -d "$ref" 2>/dev/null || true
        done
        
        # Add to count
        cleaned=$((cleaned + run_refs))
    done <<< "$all_runs"
    
    if [[ $cleaned -gt 0 ]]; then
        verbose_echo "Cleaned up $cleaned stale refs from previous runs"
    fi
}

# Exit handler - cleanup and release lock
exit_handler() {
    local exit_code=$?
    
    cleanup_temp_resources
    release_lock
    
    if [[ $exit_code -ne 0 ]]; then
        echo >&2
        echo "ERROR: Patchstack exited with code $exit_code" >&2
        echo "Temporary resources have been cleaned up" >&2
        echo "To clean up stale data from interrupted runs, see: docs/CLEANUP.md" >&2
    fi
    
    exit "$exit_code"
}

# Set up trap for cleanup
trap exit_handler EXIT INT TERM

# Discover patch branches that are descendants of origin/main
discover_patch_branches() {
    local base_ref="refs/remotes/$PATCH_REMOTE/$MAIN_BRANCH"
    local base_sha
    base_sha=$(git rev-parse "$base_ref" 2>/dev/null) || {
        echo "Error: Cannot find $base_ref" >&2
        return 1
    }

    # Collect branches that are descendants of the base
    local branches=()
    while IFS= read -r ref; do
        # Skip main branch itself
        [[ "$ref" == "$base_ref" ]] && continue

        # Skip HEAD
        [[ "$ref" == "refs/remotes/$PATCH_REMOTE/HEAD" ]] && continue

        # Check if this branch is a descendant of base
        local branch_sha
        branch_sha=$(git rev-parse "$ref")
        if git merge-base --is-ancestor "$base_sha" "$branch_sha" 2>/dev/null; then
            # Extract branch name (remove refs/remotes/origin/ prefix)
            local branch_name=${ref#refs/remotes/"$PATCH_REMOTE"/}
            branches+=("$branch_name")
        fi
    done < <(git for-each-ref --format='%(refname)' "refs/remotes/$PATCH_REMOTE")

    # Sort lexicographically and output
    if [[ ${#branches[@]} -gt 0 ]]; then
        printf '%s\n' "${branches[@]}" | sort
    fi
}

# Replay patch commits onto upstream/main
# Returns: 0=success, 1=error, 2=no-changes, 3=conflict, 4=empty
replay_patch_commits() {
    local branch_name=$1
    local remote_ref="refs/remotes/$PATCH_REMOTE/$branch_name"
    local upstream_ref="refs/remotes/$UPSTREAM_REMOTE/$MAIN_BRANCH"
    local origin_main="refs/remotes/$PATCH_REMOTE/$MAIN_BRANCH"
    local tmp_ref="$RUN_REF_PREFIX/$branch_name"
    local tmp_branch="patchstack-${RUN_ID}-tmp-$branch_name"

    # Check if branch has commits beyond origin/main
    if [[ "$(git rev-parse "$remote_ref")" == "$(git rev-parse "$origin_main")" ]]; then
        echo "WARNING: $branch_name has no commits beyond main" >&2
        return 2
    fi

    # Get list of commits to replay (between origin/main and patch branch)
    local commits
    if ! commits=$(git rev-list --reverse "$origin_main..$remote_ref" 2>&1); then
        echo "ERROR: Cannot list commits for $branch_name" >&2
        return 1
    fi

    # Check if there are any commits
    if [[ -z "$commits" ]]; then
        echo "WARNING: $branch_name has no commits to replay" >&2
        return 2
    fi

    # Create temporary branch starting from upstream/main
    verbose_echo "Creating temporary branch $tmp_branch from $upstream_ref"
    if ! git branch -f "$tmp_branch" "$upstream_ref" >/dev/null 2>&1; then
        echo "ERROR: Cannot create temporary branch" >&2
        return 1
    fi

    # Save current branch/commit
    local current_branch
    current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
    local current_head
    current_head=$(git rev-parse HEAD 2>/dev/null)

    # Checkout temporary branch
    if ! git checkout -q "$tmp_branch" 2>/dev/null; then
        git branch -D "$tmp_branch" 2>/dev/null || true
        return 1
    fi

    # Replay each commit
    local failed=0
    local empty=0
    for commit_sha in $commits; do
        # Check if this is a merge commit
        if git rev-parse "$commit_sha^2" &>/dev/null; then
            # Merge commit - create a single commit with the merge's tree
            local merge_tree
            merge_tree=$(git rev-parse "$commit_sha^{tree}")
            local msg
            msg=$(git log -1 --format=%B "$commit_sha")

            # Create a commit with the merge's tree
            local new_commit
            if ! new_commit=$(git commit-tree "$merge_tree" -p HEAD -m "$msg" 2>&1); then
                failed=1
                break
            fi
            # Update HEAD to the new commit
            git reset --hard "$new_commit" &>/dev/null
        else
            # Regular commit - cherry-pick
            if ! git cherry-pick "$commit_sha" &>/dev/null 2>&1; then
                # Check if it's an empty commit (changes already in upstream)
                if git diff-index --quiet HEAD 2>/dev/null; then
                    # Working tree is clean - this is an empty commit
                    git cherry-pick --abort &>/dev/null 2>&1 || true
                    empty=1
                else
                    # Real conflict
                    failed=1
                    break
                fi
            fi
        fi
    done

    # Return to original branch/commit
    if [[ -n "$current_branch" ]]; then
        git checkout -q "$current_branch" 2>/dev/null || true
    elif [[ -n "$current_head" ]]; then
        git checkout -q "$current_head" 2>/dev/null || true
    fi

    if [[ $failed -eq 1 ]]; then
        # Replay failed (conflict)
        git cherry-pick --abort &>/dev/null 2>&1 || true
        git branch -D "$tmp_branch" 2>/dev/null || true
        return 3
    fi

    # Always update the temporary ref (even for potentially empty patches)
    git update-ref "$tmp_ref" "$tmp_branch" >/dev/null 2>&1
    git branch -D "$tmp_branch" >/dev/null 2>&1 || true

    # Check if patch is empty (replayed tree equals upstream tree)
    local replayed_tree
    local upstream_tree
    replayed_tree=$(git rev-parse "$tmp_ref^{tree}")
    upstream_tree=$(git rev-parse "$upstream_ref^{tree}")

    if [[ "$replayed_tree" == "$upstream_tree" ]] || [[ $empty -eq 1 ]]; then
        # Empty patch detected - keep tmp ref for delete action generation
        # The tmp ref must exist so calculate_ref_updates can:
        # 1. Detect the patch as empty (by comparing trees)
        # 2. Generate a delete action for the remote ref
        # The integration phase will skip it by checking tree equality
        return 4
    fi

    return 0
}

# Replay all discovered patches
replay_all_patches() {
    local branches
    readarray -t branches < <(discover_patch_branches)

    local results=()

    for branch in "${branches[@]}"; do
        local status
        if replay_patch_commits "$branch"; then
            status="success"
            echo "Replaying $branch... ✓ success" >&2
        else
            local code=$?
            case $code in
                1) status="invalid" ;;
                2) status="no-changes" ;;
                3) status="conflict" ;;
                4) status="empty" ;;
                *) status="unknown" ;;
            esac
            echo "Replaying $branch... ✗ $status" >&2
        fi

        results+=("$branch:$status")
    done

    # Return results for later processing
    printf '%s\n' "${results[@]}"
}

# Create a squash commit of all changes in a patch branch
# Args: branch_name, parent_ref (current tip of integration branch), tmp_ref (replayed patch ref)
# Returns: 0=success (outputs SHA), 1=git error, 2=integration conflict
create_squash_commit() {
    local branch_name=$1
    local parent_ref=$2
    local tmp_ref=$3

    # Save current position
    local current_branch
    current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
    local current_head
    current_head=$(git rev-parse HEAD 2>/dev/null)
    local tmp_branch="patchstack-${RUN_ID}-integrate-$branch_name"

    # Create integration branch from parent ref
    verbose_echo "Creating integration branch $tmp_branch from $parent_ref"
    if ! git branch -f "$tmp_branch" "$parent_ref" >/dev/null 2>&1; then
        return 1
    fi

    if ! git checkout -q "$tmp_branch" >/dev/null 2>&1; then
        git branch -D "$tmp_branch" >/dev/null 2>&1 || true
        return 1
    fi

    # Attempt squash merge from replayed patch (uses git's default squash message)
    # Override merge.ff to ensure we get a commit (not a merge commit)
    if ! git -c merge.ff=true merge --squash "$tmp_ref" >/dev/null 2>&1; then
        # Conflict during integration
        git merge --abort >/dev/null 2>&1 || true
        git reset --hard >/dev/null 2>&1 || true
        # Restore original position
        if [[ -n "$current_branch" ]]; then
            git checkout -q "$current_branch" >/dev/null 2>&1 || true
        elif [[ -n "$current_head" ]]; then
            git checkout -q "$current_head" >/dev/null 2>&1 || true
        fi
        git branch -D "$tmp_branch" >/dev/null 2>&1 || true
        return 2
    fi

    # Create the squash commit with git's default message
    # Override merge.ff to ensure consistent behavior
    if ! git -c merge.ff=true commit --no-edit >/dev/null 2>&1; then
        # This can happen if there are no changes (shouldn't happen since we already replayed)
        git reset --hard >/dev/null 2>&1 || true
        # Restore original position
        if [[ -n "$current_branch" ]]; then
            git checkout -q "$current_branch" >/dev/null 2>&1 || true
        elif [[ -n "$current_head" ]]; then
            git checkout -q "$current_head" >/dev/null 2>&1 || true
        fi
        git branch -D "$tmp_branch" >/dev/null 2>&1 || true
        return 1
    fi

    # Get the commit SHA
    local squash_sha
    squash_sha=$(git rev-parse HEAD 2>/dev/null)

    # Return to original state
    if [[ -n "$current_branch" ]]; then
        git checkout -q "$current_branch" >/dev/null 2>&1 || true
    elif [[ -n "$current_head" ]]; then
        git checkout -q "$current_head" >/dev/null 2>&1 || true
    fi
    git branch -D "$tmp_branch" >/dev/null 2>&1 || true

    echo "$squash_sha"
    return 0
}

# Build new main by integrating patches sequentially
integrate_patches() {
    local upstream_ref="refs/remotes/$UPSTREAM_REMOTE/$MAIN_BRANCH"
    local integration_ref="$RUN_REF_PREFIX/main"

    # Start from upstream/main
    local current_tip
    current_tip=$(git rev-parse "$upstream_ref")

    # Get viable patches (successfully replayed) and sort lexicographically
    local viable_patches=()
    while IFS= read -r ref; do
        # Skip empty lines
        [[ -z "$ref" ]] && continue
        # Skip main ref (we're building it)
        [[ "$ref" == "$integration_ref" ]] && continue
        # Extract branch name
        local branch_name=${ref#"$RUN_REF_PREFIX/"}
        viable_patches+=("$branch_name")
    done < <(git for-each-ref --sort=refname --format='%(refname)' "$RUN_REF_PREFIX/")

    # Track results
    local integrated=()
    local failed=()

    echo "Integrating ${#viable_patches[@]} viable patches..." >&2

    for branch_name in "${viable_patches[@]}"; do
        local tmp_ref="$RUN_REF_PREFIX/$branch_name"

        # Skip empty patches (tree equals upstream)
        local tmp_tree
        local upstream_tree
        tmp_tree=$(git rev-parse "$tmp_ref^{tree}")
        upstream_tree=$(git rev-parse "$upstream_ref^{tree}")
        
        if [[ "$tmp_tree" == "$upstream_tree" ]]; then
            verbose_echo "Skipping $branch_name: empty patch (all changes already in upstream)"
            continue
        fi

        # Create squash commit
        local squash_sha
        if squash_sha=$(create_squash_commit "$branch_name" "$current_tip" "$tmp_ref"); then
            echo "Integrating $branch_name... ✓ integrated" >&2
            current_tip="$squash_sha"
            integrated+=("$branch_name")
        else
            local code=$?
            if [[ $code -eq 2 ]]; then
                echo "Integrating $branch_name... ✗ integration-conflict" >&2
                failed+=("$branch_name:integration-conflict")
            else
                echo "Integrating $branch_name... ✗ error" >&2
                failed+=("$branch_name:error")
            fi
        fi
    done

    # Set the integration ref to final tip
    git update-ref "$integration_ref" "$current_tip"

    echo >&2
    echo "Integration summary:" >&2
    echo "  Integrated: ${#integrated[@]} patches" >&2
    echo "  Failed: ${#failed[@]} patches" >&2

    # Output results (to stdout for parsing)
    for branch in "${integrated[@]}"; do
        echo "integrated:$branch"
    done

    for result in "${failed[@]}"; do
        echo "failed:$result"
    done
}

# Calculate which refs need updating based on integration results
# Takes integration results as arguments (integrated:branch or failed:branch:reason)
calculate_ref_updates() {
    local integration_main="$RUN_REF_PREFIX/main"
    
    # Check if integration main exists (it won't if there are no viable patches)
    if git rev-parse "$integration_main" &>/dev/null 2>&1; then
        local new_main_sha
        new_main_sha=$(git rev-parse "$integration_main")
        # Update main
        echo "update:refs/remotes/$PATCH_REMOTE/$MAIN_BRANCH:$new_main_sha"
    fi

    # Build a set of integrated patches for quick lookup
    declare -A integrated_set
    for result in "$@"; do
        if [[ "$result" == integrated:* ]]; then
            local branch=${result#integrated:}
            integrated_set["$branch"]=1
        fi
    done

    # Process each replayed patch by looking at temporary refs
    # (Don't use discover_patch_branches here because origin/main has been updated
    # and patches are based on upstream, not on the new integrated main)
    local tmp_refs
    readarray -t tmp_refs < <(git for-each-ref --format='%(refname)' "$RUN_REF_PREFIX/")

    verbose_echo "calculate_ref_updates: found ${#tmp_refs[@]} temp refs"

    for tmp_ref in "${tmp_refs[@]}"; do
        # Skip the main ref
        [[ "$tmp_ref" == "$integration_main" ]] && continue

        # Extract branch name from $RUN_REF_PREFIX/BRANCH
        local branch=${tmp_ref#"$RUN_REF_PREFIX/"}
        local remote_ref="refs/remotes/$PATCH_REMOTE/$branch"

        verbose_echo "calculate_ref_updates: checking branch=$branch, tmp_ref=$tmp_ref"

        # Check if this patch is already in new main (empty patch)
        # An empty patch is one where all its changes are already in upstream
        local tmp_tree
        local upstream_tree
        tmp_tree=$(git rev-parse "$tmp_ref^{tree}")
        upstream_tree=$(git rev-parse "refs/remotes/$UPSTREAM_REMOTE/$MAIN_BRANCH^{tree}")
        
        verbose_echo "calculate_ref_updates: tmp_tree=$tmp_tree, upstream_tree=$upstream_tree"
        
        if [[ "$tmp_tree" == "$upstream_tree" ]]; then
            # Empty patch - delete the ref
            verbose_echo "calculate_ref_updates: $branch is empty, deleting"
            echo "delete:$remote_ref"
        elif [[ -n "${integrated_set[$branch]:-}" ]]; then
            # Only update if patch was successfully integrated
            local new_sha
            new_sha=$(git rev-parse "$tmp_ref")
            verbose_echo "calculate_ref_updates: $branch updated to $new_sha"
            echo "update:$remote_ref:$new_sha"
        else
            # Patch failed integration - leave unchanged
            verbose_echo "calculate_ref_updates: $branch failed integration, leaving unchanged"
        fi
    done
}

# Record metadata about the sync operation in Git notes
record_notes() {
    local ref=$1
    local old_sha=$2
    local new_sha=$3
    local status=$4

    local branch_name=${ref#refs/remotes/"$PATCH_REMOTE"/}
    local timestamp
    timestamp=$(date -u +"%Y-%m-%d %H:%M:%S UTC")

    local note="Patchstack sync: $timestamp
Branch: $branch_name
Status: $status
Old SHA: $old_sha
New SHA: $new_sha
"

    # Add note to the relevant commit (new tip, or old tip for deletions)
    local target_sha
    if [[ "$new_sha" == "deleted" ]]; then
        target_sha="$old_sha"
    else
        target_sha="$new_sha"
    fi

    if [[ -n "${target_sha:-}" ]]; then
        git notes --ref=patchstack add -f -m "$note" "$target_sha" 2>/dev/null || true
    fi
}

# Apply all calculated ref updates atomically
# Takes integration results as arguments
apply_ref_updates() {
    local updates
    readarray -t updates < <(calculate_ref_updates "$@")

    if [[ ${#updates[@]} -eq 0 ]]; then
        echo "No ref updates needed"
        return 0
    fi

    echo "Applying ${#updates[@]} ref updates..."

    # Build list of updates for atomic transaction
    local update_cmds=()
    local note_data=()

    for update in "${updates[@]}"; do
        local action=${update%%:*}
        local rest=${update#*:}

        if [[ "$action" == "update" ]]; then
            local ref=${rest%%:*}
            local new_sha=${rest#*:}
            local old_sha
            old_sha=$(git rev-parse "$ref" 2>/dev/null || echo "")

            echo "  Updating $ref"

            # Prepare update-ref command
            if [[ -n "$old_sha" ]]; then
                update_cmds+=("update $ref $new_sha $old_sha")
            else
                update_cmds+=("create $ref $new_sha")
            fi

            # Collect note data for later (after transaction succeeds)
            note_data+=("$ref:$old_sha:$new_sha:updated")

        elif [[ "$action" == "delete" ]]; then
            local ref=$rest
            local old_sha
            old_sha=$(git rev-parse "$ref" 2>/dev/null || echo "")

            echo "  Deleting $ref"

            if [[ -n "$old_sha" ]]; then
                update_cmds+=("delete $ref $old_sha")
                # Collect note data for later (after transaction succeeds)
                note_data+=("$ref:$old_sha:deleted:empty")
            fi
        fi
    done

    # Execute atomic update
    if [[ ${#update_cmds[@]} -gt 0 ]]; then
        if printf '%s\n' "${update_cmds[@]}" | git update-ref --stdin; then
            echo "✓ All refs updated successfully"
            
            # Only write notes after successful update
            for note in "${note_data[@]}"; do
                IFS=: read -r ref old_sha new_sha status <<< "$note"
                record_notes "$ref" "$old_sha" "$new_sha" "$status"
            done
            
            return 0
        else
            echo "✗ Ref update failed"
            return 1
        fi
    fi

    return 0
}

# Capture the current state of remote tracking refs before updating
# Output format: ref:old_sha
# Takes integration results as arguments
capture_ref_state() {
    local updates
    readarray -t updates < <(calculate_ref_updates "$@")

    for update in "${updates[@]}"; do
        local action=${update%%:*}
        local rest=${update#*:}

        if [[ "$action" = "update" ]]; then
            local ref=${rest%%:*}
            local old_sha
            old_sha=$(git rev-parse "$ref" 2>/dev/null || echo "")
            echo "$ref:$old_sha"
        elif [[ "$action" = "delete" ]]; then
            local ref=$rest
            local old_sha
            old_sha=$(git rev-parse "$ref" 2>/dev/null || echo "")
            echo "$ref:$old_sha"
        fi
    done
}

# Build refspec list for atomic push with force-with-lease
# Takes the pre-update ref state file path and integration results as input
build_push_refspecs() {
    local ref_state_file=$1
    shift  # Remove first argument, rest are integration results
    local refspecs=()
    local lease_options=()

    # Get all updated refs from previous phase
    local updates
    readarray -t updates < <(calculate_ref_updates "$@")

    verbose_echo "calculate_ref_updates returned ${#updates[@]} updates:"
    for u in "${updates[@]}"; do
        verbose_echo "  $u"
    done

    # Build a map of old SHAs from the captured state
    declare -A old_shas
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        local ref=${line%%:*}
        local old_sha=${line#*:}
        old_shas["$ref"]=$old_sha
        verbose_echo "Captured old SHA for $ref: $old_sha"
    done < "$ref_state_file"

    for update in "${updates[@]}"; do
        local action=${update%%:*}
        local rest=${update#*:}

        if [[ "$action" = "update" ]]; then
            local ref=${rest%%:*}
            local new_sha=${rest#*:}
            local old_sha="${old_shas[$ref]-}"

            # Validate that we have captured old SHA for this ref
            if [[ -z "$old_sha" ]]; then
                echo "ERROR: No captured state for ref $ref" >&2
                return 1
            fi

            verbose_echo "Processing update: ref=$ref, new=$new_sha, old=$old_sha"

            # Extract branch name from ref
            local branch_name=${ref#refs/remotes/"$PATCH_REMOTE"/}

            # Add refspec: local_sha:remote_ref
            refspecs+=("$new_sha:refs/heads/$branch_name")

            # Always add force-with-lease for concurrency protection
            lease_options+=("--force-with-lease=refs/heads/$branch_name:$old_sha")

        elif [[ "$action" = "delete" ]]; then
            local ref=$rest
            local branch_name=${ref#refs/remotes/"$PATCH_REMOTE"/}
            local old_sha="${old_shas[$ref]-}"

            # Validate that we have captured old SHA for deletion
            if [[ -z "$old_sha" ]]; then
                echo "ERROR: No captured state for ref $ref" >&2
                return 1
            fi

            verbose_echo "Processing delete: ref=$ref, old=$old_sha"

            # Add deletion refspec: :remote_ref
            refspecs+=(":refs/heads/$branch_name")

            # Always add force-with-lease for deletion
            lease_options+=("--force-with-lease=refs/heads/$branch_name:$old_sha")
        fi
    done

    # Output refspecs and lease options
    for spec in "${refspecs[@]}"; do
        echo "refspec:$spec"
    done

    for opt in "${lease_options[@]}"; do
        echo "lease:$opt"
    done
}

# Executes the atomic push with all refspecs
# Takes ref state file path and integration results as arguments
push_refs() {
    local ref_state_file=$1
    shift  # Remove first argument, rest are integration results
    echo "Preparing push..."

    local pushspecs
    readarray -t pushspecs < <(build_push_refspecs "$ref_state_file" "$@")

    if [[ ${#pushspecs[@]} -eq 0 ]]; then
        echo "No changes to push"
        return 0
    fi

    # Debug: show pushspecs
    verbose_echo "Pushspecs generated:"
    for ps in "${pushspecs[@]}"; do
        verbose_echo "  $ps"
    done

    # Parse refspecs and lease options
    local refspecs=()
    local lease_opts=()

    for spec in "${pushspecs[@]}"; do
        local type=${spec%%:*}
        local value=${spec#*:}

        if [[ "$type" = "refspec" ]]; then
            refspecs+=("$value")
        elif [[ "$type" = "lease" ]]; then
            lease_opts+=("$value")
        fi
    done

    echo "Pushing ${#refspecs[@]} refs to $PATCH_REMOTE..."

    # Debug: show what we're pushing
    verbose_echo "Refspecs:"
    for rs in "${refspecs[@]}"; do
        verbose_echo "  $rs"
    done
    verbose_echo "Lease options:"
    for lo in "${lease_opts[@]}"; do
        verbose_echo "  $lo"
    done

    # Build push command
    local push_cmd=(git push --atomic)

    # Add lease options
    for opt in "${lease_opts[@]}"; do
        push_cmd+=("$opt")
    done

    # Add remote
    push_cmd+=("$PATCH_REMOTE")

    # Add refspecs
    for spec in "${refspecs[@]}"; do
        push_cmd+=("$spec")
    done

    # Execute push
    if "${push_cmd[@]}" 2>&1; then
        echo "✓ Push successful"
        return 0
    else
        local code=$?
        echo "✗ Push failed (exit code: $code)"
        echo
        echo "This usually means:"
        echo "  - Someone else pushed to origin while you were syncing"
        echo "  - Run 'git fetch' and try sync again"
        echo "  - Or check remote permissions"
        return 1
    fi
}

# Pushes Git notes to remote
push_notes() {
    echo "Pushing notes..."

    if git push "$PATCH_REMOTE" refs/notes/patchstack 2>&1; then
        echo "✓ Notes pushed"
        return 0
    else
        echo "⚠ Notes push failed (non-fatal)"
        return 0  # Don't fail sync if notes fail
    fi
}

# List command: show all patch branches
cmd_list() {
    local patches
    patches=$(discover_patch_branches)

    if [[ -z "$patches" ]]; then
        echo "No patch branches found"
        return 0
    fi

    echo "$patches"
    echo
    local count
    count=$(echo "$patches" | wc -l | tr -d ' ')
    echo "Found $count patch branches"
}

# Sync command: synchronize patch stack with upstream
cmd_sync() {
    # Generate unique run ID for this sync operation
    # Uses timestamp + random to ensure uniqueness across concurrent runs
    RUN_ID="$(date +%Y%m%d-%H%M%S)-$$-${RANDOM}"
    RUN_REF_PREFIX="refs/patchstack/runs/$RUN_ID"
    
    # Acquire lock first to prevent concurrent runs
    acquire_lock
    
    # Clean up stale refs from previous runs (after acquiring lock, before main sync operations)
    cleanup_stale_refs
    
    # Create run-specific temporary directory
    RUN_TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/patchstack-${RUN_ID}.XXXXXX")"
    
    echo "🚀 Starting patchstack sync (run: $RUN_ID)..."
    echo

    # Phase 1: Discovery
    echo "🔍 Phase 1: Discovering patch branches"
    local patches
    readarray -t patches < <(discover_patch_branches)
    echo "Found ${#patches[@]} patch branches"
    echo

    if [[ ${#patches[@]} -eq 0 ]]; then
        echo "No patches to sync"
        return 0
    fi

    # Phase 2: Replay
    echo "🔄 Phase 2: Replaying patches onto upstream"
    local replay_results
    readarray -t replay_results < <(replay_all_patches)

    # Count viable patches
    local viable=0
    for result in "${replay_results[@]}"; do
        if [[ "$result" == *:success ]]; then
            viable=$((viable + 1))
        fi
    done
    echo "Viable patches: $viable"
    echo

    # Phase 3: Integration
    local integration_results=()
    if [[ $viable -eq 0 ]]; then
        echo "📦 Phase 3: No patches to integrate"
        echo
        # Still need to handle empty patches and update refs
    else
        echo "📦 Phase 3: Integrating patches into new main"
        # Capture integration results for summary
        readarray -t integration_results < <(integrate_patches)
        echo
    fi

    # Capture ref state BEFORE Phase 4 updates them (for force-with-lease)
    local ref_state_file="$RUN_TEMP_DIR/ref-state"
    capture_ref_state "${integration_results[@]}" > "$ref_state_file"

    # Phase 4: Update refs (always run to handle empty patches)
    echo "🔄 Phase 4: Updating local refs"
    
    # Check if we have viable patches or only need to clean up
    if [[ $viable -gt 0 ]]; then
        if ! apply_ref_updates "${integration_results[@]}"; then
            echo "ERROR: Failed to update refs"
            return 1
        fi
    else
        # No viable patches, but we might need to delete empty patch refs
        # For empty patches, we need to manually create delete updates
        local has_empty=false
        for result in "${replay_results[@]}"; do
            if [[ "$result" == *:empty ]]; then
                has_empty=true
                break
            fi
        done
        
        if [[ "$has_empty" == "true" ]]; then
            echo "Deleting empty patch refs..."
            local update_cmds=()
            local note_data=()
            for result in "${replay_results[@]}"; do
                if [[ "$result" == *:empty ]]; then
                    local branch=${result%%:*}
                    local ref="refs/remotes/$PATCH_REMOTE/$branch"
                    local old_sha
                    old_sha=$(git rev-parse "$ref" 2>/dev/null || echo "")
                    
                    if [[ -n "$old_sha" ]]; then
                        echo "  Deleting $ref"
                        update_cmds+=("delete $ref $old_sha")
                        # Collect note data for later (after transaction succeeds)
                        note_data+=("$ref:$old_sha:deleted:empty")
                    fi
                fi
            done
            
            if [[ ${#update_cmds[@]} -gt 0 ]]; then
                if printf '%s\n' "${update_cmds[@]}" | git update-ref --stdin; then
                    echo "✓ Empty patch refs deleted"
                    
                    # Only write notes after successful update
                    for note in "${note_data[@]}"; do
                        IFS=: read -r ref old_sha new_sha status <<< "$note"
                        record_notes "$ref" "$old_sha" "$new_sha" "$status"
                    done
                else
                    echo "✗ Failed to delete refs"
                    return 1
                fi
            fi
        else
            echo "No ref updates needed"
        fi
    fi
    echo

    # Phase 5: Push to remote
    echo "🚀 Phase 5: Pushing to $PATCH_REMOTE"
    if ! push_refs "$ref_state_file" "${integration_results[@]}"; then
        echo "ERROR: Push failed"
        echo "Local refs updated but remote unchanged"
        rm -f "$ref_state_file"
        return 1
    fi

    # Clean up ref state file
    rm -f "$ref_state_file"

    # Push notes (non-fatal)
    push_notes
    echo

    # Final summary
    echo "==================================="
    echo "📊 Sync Complete"
    echo "==================================="
    echo

    # Count different outcomes
    local success=0
    local failed_count=0
    local empty=0
    local failed_patches=()
    local empty_patches=()

    # Build a set of integration failures
    declare -A integration_failures
    for result in "${integration_results[@]}"; do
        if [[ "$result" == failed:* ]]; then
            local branch_and_reason=${result#failed:}
            local branch=${branch_and_reason%%:*}
            local reason=${branch_and_reason#*:}
            integration_failures["$branch"]="$reason"
        fi
    done

    # Process replay results, taking integration into account
    for result in "${replay_results[@]}"; do
        local patch=${result%%:*}
        local status=${result#*:}
        
        # Check if this patch failed integration
        if [[ -n "${integration_failures[$patch]:-}" ]]; then
            ((failed_count++)) || true
            failed_patches+=("$patch (${integration_failures[$patch]})")
        elif [[ "$status" == "success" ]]; then
            ((success++)) || true
        elif [[ "$status" == "empty" ]]; then
            ((empty++)) || true
            empty_patches+=("$patch")
        else
            # Replay failure (conflict, invalid, etc)
            ((failed_count++)) || true
            failed_patches+=("$patch ($status)")
        fi
    done

    # Show summary
    if [[ $success -gt 0 ]]; then
        echo "✓ Synced: $success patches"
    fi
    
    if [[ $empty -gt 0 ]]; then
        echo "○ Removed: $empty empty patches"
        for patch in "${empty_patches[@]}"; do
            echo "  - $patch (already merged upstream)"
        done
    fi
    
    if [[ $failed_count -gt 0 ]]; then
        echo "✗ Failed: $failed_count patches"
        for patch_info in "${failed_patches[@]}"; do
            echo "  - $patch_info"
        done
        echo
        echo "Failed patches remain unchanged at their original commits."
        echo "To fix: manually resolve conflicts and re-run sync."
    fi
    
    echo
    echo "✓ Remote updated"
}

# Usage information
usage() {
    cat <<EOF
Usage: patchstack <command>

Commands:
    list    List all patch branches
    sync    Synchronize patch stack with upstream

Description:
    Patchstack maintains long-living forks as deterministic patch stacks
    on top of upstream repositories.

Configuration:
    PATCH_REMOTE    Remote for patch branches (default: origin)
    UPSTREAM_REMOTE Remote for upstream (default: upstream)
    MAIN_BRANCH     Main branch name (default: main)
EOF
}

# Main entry point
main() {
    local command="${1:-}"

    case "$command" in
        list)
            cmd_list
            ;;
        sync)
            cmd_sync
            ;;
        "")
            usage
            exit 1
            ;;
        *)
            echo "Error: Unknown command '$command'" >&2
            echo >&2
            usage
            exit 1
            ;;
    esac
}

main "$@"
